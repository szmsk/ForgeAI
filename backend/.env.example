# Runtime
FORGEAI_ENVIRONMENT=development
FORGEAI_LOG_LEVEL=INFO
FORGEAI_CORS_ORIGINS=http://localhost:3000
FORGEAI_ALLOWED_HOSTS=localhost,127.0.0.1

# Database / queue
FORGEAI_DATABASE_URL=postgresql+asyncpg://forgeai:forgeai_dev_only@localhost:5432/forgeai
FORGEAI_REDIS_URL=redis://localhost:6379/0

# Authentication: generate a long random value for real deployments
FORGEAI_JWT_SECRET=replace-with-a-long-random-secret
FORGEAI_ACCESS_TOKEN_MINUTES=60

# LLM (optional for deterministic demo mode)
FORGEAI_LLM_BASE_URL=
FORGEAI_LLM_API_KEY=
FORGEAI_LLM_MODEL=demo

# GitHub (optional for local demo)
FORGEAI_GITHUB_TOKEN=

# Sandbox
FORGEAI_SANDBOX_BACKEND=docker
FORGEAI_SANDBOX_RUNTIME_CLASS=gvisor
FORGEAI_SANDBOX_IMAGE=forgeai-sandbox:latest

# Object storage
FORGEAI_S3_ENDPOINT=http://localhost:9000
FORGEAI_S3_ACCESS_KEY=forgeai
FORGEAI_S3_SECRET_KEY=forgeai_dev_only
FORGEAI_ARTIFACT_BUCKET=forgeai-artifacts

# Observability
FORGEAI_OTEL_ENABLED=true
FORGEAI_OTEL_ENDPOINT=http://localhost:4317
